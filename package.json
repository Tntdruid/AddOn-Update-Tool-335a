{
  "name": "addon-update-tool-335",
  "productName": "AddOn Update Tool 3.3.5a",
  "version": "0.2.0",
  "description": "Smart desktop updater for World of Warcraft 3.3.5a AddOns hosted on GitHub, GitLab or Gitea/Codeberg",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dk.addonupdatetool.wotlk",
    "productName": "AddOn Update Tool 3.3.5a",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AddonUpdateTool-${version}-portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tntdruid/AddOn-Update-Tool-335a"
  }
}
